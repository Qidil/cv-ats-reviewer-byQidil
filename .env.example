# Copy this file to .env.local and fill it in. .env.local is never committed.
# Every variable is read by lib/api/config.ts on the server; none of them reaches the browser.

# OpenRouter key behind the app's free quota. Without it, only personal keys (Settings) can analyze.
OPENROUTER_API_KEY=

# First model of the chain, then comma-separated fallbacks tried in order.
# Leave OPENROUTER_FREE_MODELS empty to use the list in lib/api/config.ts.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FREE_MODELS=

# Time budget for one analysis across the whole model chain, in milliseconds.
OPENROUTER_TIMEOUT_MS=120000

# Free-quota analyses per client per day, and requests per client per clock hour with any key.
# Raising both helps local testing; keep 10 and 20 (or leave them unset) in production.
DAILY_ANALYSIS_LIMIT=10
HOURLY_REQUEST_LIMIT=20

# Secret for hashing client IP addresses in the counters. Required in production; generate one with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
QUOTA_HASH_SECRET=

# true lets personal keys reach a local or private model server (plain HTTP, localhost, LAN or Tailscale
# addresses) through the endpoint address in Settings. Only for a server you control, such as a local
# run. Keep it off on a public deployment: it would let every visitor reach the host's own network.
ALLOW_PRIVATE_ENDPOINTS=false

# Upstash Redis REST credentials for the counters. KV_REST_API_URL and KV_REST_API_TOKEN, the names the
# Vercel Marketplace uses, work too. Without them, development counts in memory and production turns
# the free quota off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
